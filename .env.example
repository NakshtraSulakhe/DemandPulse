SLIDES_DATABASE_URL="mysql://u449458970_demandpulse:TaRajGlobal%402026%23@localhost:3306/u449458970_demandpulse?connect_timeout=30"

# Case B: When Next.js runs remotely (e.g. on Vercel / Render / AWS):
# (Requires enabling Remote MySQL for your IP or % in Hostinger hPanel -> Databases -> Remote MySQL)
# SLIDES_DATABASE_URL="mysql://u449458970_demandpulse:TaRajGlobal%402026%23@YOUR_HOSTINGER_SERVER_IP:3306/u449458970_demandpulse?connect_timeout=30"

# DemandFlow Live Analytics Environment Configuration

# Base URL to DemandFlow Bridge CRM REST API (server-side only)
CRM_API_BASE_URL=http://localhost/demandflowbridge/api/v1

# CRM API Token (if token-based auth is configured on the PHP API)
CRM_API_TOKEN=df_admin_secret_token_2026

# Optional dedicated CRM Incentives API URL (defaults to ${CRM_API_BASE_URL}/incentives)
CRM_INCENTIVES_API_URL=https://app.tarajglobal.com/demandflowbridge/api/v1/incentives

# Admin Authorization Secret (protects Next.js admin write endpoints)
ADMIN_AUTH_TOKEN=df_admin_secret_token_2026

# App Branding
NEXT_PUBLIC_APP_NAME=DemandFlow Live Analytics

# Presentation & Dashboard Live Polling Refresh Interval (milliseconds)
NEXT_PUBLIC_REFRESH_INTERVAL=30000
